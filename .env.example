# =================================================================
# College Portal - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your
# own secure credentials before starting the application:
# cp .env.example .env
# =================================================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password_here
MYSQL_DATABASE=college_db
MYSQL_USER=college_user
MYSQL_PASSWORD=your_strong_college_user_password_here

# Backend Service Configuration (used inside Docker network)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/college_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=college_user
SPRING_DATASOURCE_PASSWORD=your_strong_college_user_password_here

# Frontend Configuration
PORT=80
